;; === TRUE FLIGHT MOD ===
;; Each wing flap now NETS altitude instead of just slowing the fall: the flap adds to
;; whatever climb you already have (capped), and gravity stays floaty between flaps, so
;; flight is paced by the flap animation the way the wings imply.
(defconstant TF-FLAP-IMPULSE (meters 12))  ;; added per flap
(defconstant TF-CLIMB-CAP    (meters 20))  ;; fastest climb from stacked flaps
(defconstant TF-GRAVITY      81920.0)      ;; ~20 m/s^2 (vanilla flap window used 163840)

;; === DARK JAK FLIGHT: its own feel ===
;; Light Jak floats; Dark Jak surges. Fewer, harder flaps that throw him forward, heavier between
;; flaps, a glide that sinks faster and cuts sharper, a hunched predatory posture, dark sounds, and
;; R1 turns the boost into a ram that hits whatever he flies through.
(define *tf-dark-glide-pitch*  30.0)         ;; leans forward into the glide, degrees (Light: upright)
(define *tf-dark-hunch*        25.0)         ;; chest hunched forward while flying, degrees
(define *tf-dark-hunch-now*    0.0)

(define *tf-dark-swoop-mods* (let ((m (copy *lightjak-swoop-mods* 'global)))
                               (set! (-> m name) 'dark-swoop)
                               (set! (-> m transv-max) (meters 26))
                               (set! (-> m target-speed) (meters 26))
                               (set! (-> m turnv) 163840.0)
                               m
                               )
  )

(defun true-flight-dark-chest-joint ((node cspace) (tq transformq))
  "Hunches Dark Jak's chest forward while he flies; eases back and unhooks itself after."
  (let ((want (if (and *tf-dark-mode?* *true-flight-cam?*) *tf-dark-hunch* 0.0)))
    (set! *tf-dark-hunch-now* (if (< *tf-dark-hunch-now* want)
                                  (fmin want (+ *tf-dark-hunch-now* 2.0))
                                  (fmax want (- *tf-dark-hunch-now* 2.0))
                                  )
          )
    )
  (cond
    ((!= *tf-dark-hunch-now* 0.0)
     (let ((r (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 1.0 0.0 0.0 (degrees *tf-dark-hunch-now*))))
       (quaternion*! (-> tq quat) r (-> tq quat))
       )
     )
    ((not *tf-dark-mode?*)
     (set! (-> node param0) #f)
     )
    )
  (cspace<-parented-transformq-joint! node tq)
  (none)
  )

(defbehavior true-flight-flap-sound target ()
  (if *tf-dark-mode?*
      (sound-play "djak-pnch-swing" :pitch -0.35) ;; a heavy dark whoosh, not Light Jak's chime
      (sound-play "ltjak-flap")
      )
  (none)
  )

(defbehavior true-flight-dark-flap target ()
  "Right after a flap's lift: Dark Jak surges forward and the wings flare (and often crackle)."
  (when *tf-dark-mode?*
    (if (rand-vu-percent? 0.5)
        (set! *tf-dark-wing-zap?* #t)
        )
    (let ((fwd (vector-z-quaternion! (new-stack-vector0) (-> self control quat-for-control))))
      (set! (-> fwd y) 0.0)
      (vector-normalize! fwd 1.0)
      (vector+float*! (-> self control transv) (-> self control transv) fwd *fc-dark-flap-surge*)
      )
    )
  (none)
  )

;; ---- hit in flight (Light and Dark): flinch in the air, then fly on (as Dark Flight in Jak 2) ----

(defbehavior true-flight-hit-trans target ()
  "From target-hit's :trans. The frame count lets the state's :code apply the damage (and go to
   target-death if it's fatal) before we leave."
  (if (zero? *tf-hit-frames*)
      (set! *tf-hit-flying?* (not (time-elapsed? *tf-fly-time* (seconds 0.2))))
      )
  (set! *tf-hit-frames* (+ *tf-hit-frames* 1))
  (when (and *tf-hit-flying?*
             (focus-test? self light dark)
             (not (focus-test? self dead))
             (not (logtest? (-> self control status) (collide-status on-surface on-ground)))
             )
    (let* ((up (-> self control dynam gravity-normal))
           (vs (vector-dot up (-> self control transv)))
           )
      (if (< vs 0.0) ;; hang in the air through the flinch
          (vector+float*! (-> self control transv) (-> self control transv) up (- vs))
          )
      )
    (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
    (when (< *fc-hit-stagger* *tf-hit-frames*)
      (set! *tf-hit-frames* 0)
      (set! *tf-hit-flying?* #f)
      (set-time! *tf-fly-time*)
      ;; back to flying -- the flight states play Light Jak's animations, so only if that set is in
      (if (or (focus-test? self light) (= (-> self ext-anim) (target-anim light)))
          (go target-lightjak-swoop-falling #f)
          (go target-falling #f)
          )
      )
    )
  (none)
  )

(define-extern *tf-gliding?* symbol)   ;; (glide state, defined further down)
(define-extern *fc-in-city?* symbol)   ;; (city mode, defined further down)
(define-extern *tf-glide-speed* float)
(define *tf-dark-dash-start*    (the-as time-frame 0))
(define *tf-dark-dashing?*      #f)

;; the dash: no steering or drag while it lasts (the normal air control pulled the lunge straight
;; back to stick speed within a few frames -- all that was left was the rumble)
(define *tf-dark-dash-mods* (let ((m (copy *lightjak-swoop-fast-mods* 'global)))
                              (set! (-> m name) 'dark-dash)
                              (set! (-> m seek0) 0.0)
                              (set! (-> m seek90) 0.0)
                              (set! (-> m seek180) 0.0)
                              (set! (-> m fric) 0.0)
                              m
                              )
  )

(defbehavior tf-dark-fx target ((group sparticle-launch-group) (joint int) (dur time-frame))
  "Spawn one of Dark Jak's effects on his bone JOINT (it follows him)."
  (vector<-cspace! (-> *launch-matrix* trans) (-> self node-list data joint))
  (if (logtest? (-> group flags) (sp-group-flag sp13))
      (part-tracker-spawn part-tracker-subsampler :to self :group group :duration dur :target self :mat-joint joint)
      (part-tracker-spawn part-tracker :to self :group group :duration dur :target self :mat-joint joint)
      )
  (none)
  )

(defbehavior true-flight-dark-ram target ()
  "R1 as Dark Jak = a dash attack: a level lunge forward in a streak of sparks and lightning, with
   a small dark-bomb hit sphere that hits whatever he flies through. (Holding R1 after it still
   boosts, as for Light Jak.)"
  ;; (Light Jak dashes too: the same lunge and rumble, in a shower of light instead, and harmless)
  (set! *tf-dark-dashing?* (not (time-elapsed? *tf-dark-dash-start* *fc-dash-time*)))
  (when (and (or (and *tf-dark-mode?* (true-flight-dark?)) (focus-test? self light))
             (cpad-pressed? (-> self control cpad number) r1)
             (!= (-> self state name) 'target-lightjak-slam)
             (time-elapsed? *tf-dark-dash-start* *fc-dash-cooldown*)
             )
    (set-time! *tf-dark-dash-start*)
    (set! *tf-dark-dashing?* #t)
    (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 180 (seconds 0.15))
    (cond
      (*tf-dark-mode?*
        (target-start-attack) ;; a fresh attack, so everything can be hit again
        (sound-play "djak-bolt-throw")
        (sound-play "djak-pnch-swing" :pitch -0.2)
        (set! *tf-dark-wing-zap?* #t)
        ;; Dark Jak's own smack effects: the hit burst, and the glowing trail behind him for the lunge
        (tf-dark-fx group-darkjak-smack-hit 6 (seconds 0))
        (tf-dark-fx group-darkjak-smack-trail 6 *fc-dash-time*)
        (activate! *camera-smush-control* 300.0 15 30 1.0 0.9 (-> *display* camera-clock))
        )
      (else
        ;; Light Jak: a spray of glitter (from the freeze burst, minus its blue cloud and its star
        ;; flash, which both hung in the air like a puff left behind), then a streak of stars
        (sound-play "ltjak-flap" :pitch 0.4)
        (let ((p (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data 6))))
          (launch-particles (-> *part-id-table* 657) p) ;; white glitter (no star flash: it left a white blob)
          )
        (activate! *camera-smush-control* 150.0 15 30 1.0 0.9 (-> *display* camera-clock))
        )
      )
    (if *tf-gliding?* ;; the glide carries its own speed: give it the lunge (it bleeds off as momentum)
        (set! *tf-glide-speed* (fmax *tf-glide-speed* (if *fc-in-city?* *fc-dash-city-speed* *fc-dash-speed*)))
        )
    )
  (when *tf-dark-dashing?*
    (when (not *tf-gliding?*)
      (let ((fwd (vector-z-quaternion! (new-stack-vector0) (-> self control quat-for-control))))
        (set! (-> fwd y) 0.0)
        (vector-normalize! fwd (if *fc-in-city?* *fc-dash-city-speed* *fc-dash-speed*))
        (set! (-> self control transv x) (-> fwd x))
        (set! (-> self control transv z) (-> fwd z))
        (set! (-> self control transv y) (fmax 0.0 (-> self control transv y))) ;; a level lunge
        )
      )
    (when (not *tf-dark-mode?*) ;; Light Jak: a streak of glittering stars (fairy dust) -- only the
      ;; crisp stars: soft glows and the dense glitter burst read as a white cloud
      (dotimes (i 16)
        (launch-particles (-> *part-id-table* 646) (process-drawable-random-point! self (new 'stack-no-clear 'vector)))
        )
      )
    (when *tf-dark-mode?*
    ;; the dark streak
    (dotimes (i 4)
      (launch-particles (-> *part-id-table* 173) (process-drawable-random-point! self (new 'stack-no-clear 'vector)))
      )
    (if (rand-vu-percent? 0.4)
        (process-drawable-shock-effect self (-> *lightning-spec-id-table* 7) lightning-probe-callback
                                       (-> *part-id-table* 187) 0 0 40960.0
                                       )
        )
    ;; the hit
    (fc-dash-hit)
      )
    )
  (none)
  )

;; === TRUE FLIGHT: launch tilt (as Dark Flight) ===
;; A flap out of a glide lifts Jak's nose for the launch, then eases back. Callback on his root
;; bone "main" (node 3, otherwise unused); attached every frame in true-flight-lift (the bone
;; keeps whatever function object it was given), and it unhooks itself once Jak is upright.
(define *tf-glide-pitch*  0.0)    ;; body tilt while gliding (Light Jak's glide pose is upright)
(define *tf-launch-pitch* -27.0)  ;; launch: 27 degrees nose-up from the glide (same change as Jak 2's 72 -> 45)
(define *tf-body-pitch*   0.0)
(define *tf-launch-until* (the-as time-frame 0))
(define *tf-launching?*   #f)
(define *tf-tilt-glide?*  #f)     ;; mirrors *tf-gliding?* (defined further down)

(defun true-flight-main-joint ((node cspace) (tq transformq))
  (let ((want (cond
                (*tf-launching?* *tf-launch-pitch*)
                (*tf-tilt-glide?* (if *tf-dark-mode?* *tf-dark-glide-pitch* *tf-glide-pitch*))
                (else 0.0)
                )
              )
        )
    (set! *tf-body-pitch*
          (if (< *tf-body-pitch* want)
              (fmin want (+ *tf-body-pitch* *fc-pitch-step*))
              (fmax want (- *tf-body-pitch* *fc-pitch-step*))
              )
          )
    )
  (if (!= *tf-body-pitch* 0.0)
      (let ((r (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 1.0 0.0 0.0 (degrees *tf-body-pitch*))))
        (quaternion*! (-> tq quat) r (-> tq quat))
        )
      (if (not (or *tf-launching?* *tf-tilt-glide?*)) ;; upright and nothing to tilt for: unhook
          (set! (-> node param0) #f)                   ;; (true-flight-lift re-attaches it in flight)
          )
      )
  (cspace<-parented-transformq-joint! node tq)
  (none)
  )


;; === TRUE FLIGHT: CITY MODE ===
;; Haven only keeps ~2 districts loaded and swaps them via trigger regions, and its visibility
;; data was built for street level -- so in the city: a soft altitude ceiling (absolute height,
;; never height-above-ground), and the districts ahead are loaded by location (below).
;; absolute-Y ceilings per district = highest STANDABLE surface + 8 m, at least 40 m (so the
;; zoomer lanes are always reachable). Surfaces from a downward-ray survey of each district's
;; collision: port 64.9, ctygen 51.8, slumc 46.7, indb 43.8, slumb 30.6,
;; inda 26.8, sluma 24.9. Main city visibility breaks from ~46 m, above which only a tower is.
(define *tf-ceil-port*      (meters 73))
(define *tf-ceil-gen*       (meters 60))
(define *tf-ceil-slumc*     (meters 55))
(define *tf-ceil-indb*      (meters 52))
(define *tf-ceil-default*   (meters 40))  ;; sluma, slumb, inda and the rest of the city

;; Load by location: twice a second while flying in the city, load the district you're heading for.
;; Districts are walled off and loaded by trigger regions at the gates, which flying over the walls
;; never crosses; every continue point lists what to load at that spot, so use the nearest one ahead.
;; ONLY real districts (each has a DGO): the level list also has continue points for levels with no
;; file (ctyfence), and asking for one crashes the game.
;; Haven's districts (for the ceilings and the city speed caps; the streamer itself is generic,
;; see flight-stream.gc).
(define *tf-city-districts* '(ctysluma ctyslumb ctyslumc ctygenb ctyinda ctyindb ctyport ctyfarma ctyfarmb))

;; The region look-ahead (region.gc) makes the gate scripts fire a little early for interiors.

(defbehavior true-flight-city target ()
  "Per frame while flying: city detection, district streaming, altitude ceiling."
  (set! *fc-in-city?* (if (and (-> self current-level)
                               (string-prefix= "cty" (symbol->string (-> self current-level name)))
                               )
                          #t
                          #f
                          )
        )
  (fs-tick)
  (when *fc-in-city?*
    ;; the ceiling of the district Jak is actually over (current-level lags far behind in flight;
    ;; the streamer's continue-point lookup is current)
    (let ((nm (symbol->string (if (and *fs-stream-now* (member *fs-stream-now* *tf-city-districts*)) *fs-stream-now* (-> self current-level name)))))
      (set! *fc-city-ceiling* (cond
                                ((string-prefix= "ctyport" nm) *tf-ceil-port*)
                                ((string-prefix= "ctygen" nm) *tf-ceil-gen*)
                                ((string-prefix= "ctyslumc" nm) *tf-ceil-slumc*)
                                ((string-prefix= "ctyindb" nm) *tf-ceil-indb*)
                                (else *tf-ceil-default*)
                                )
            )
      )
    )
  (cond
    (*fc-in-city?*
      (let ((v (vector-float*! (new-stack-vector0) (-> self control transv) *fc-region-ahead*)))
        (set! (-> v y) 0.0)
        (set! (-> v w) 0.0)
        (if (< *fc-region-ahead-max* (vector-length v))
            (vector-normalize! v *fc-region-ahead-max*)
            )
        (vector-copy! *tf-region-lookahead* v)
        )
      (when (< 0.0 *fc-city-ceiling*)
        (let ((above (- (-> self control trans y) (- *fc-city-ceiling* *fc-city-soft*)))
              (vs (-> self control transv y))
              )
          (when (and (< 0.0 above) (< 0.0 vs))
            ;; fade the climb to nothing at the ceiling
            (set! (-> self control transv y) (* vs (fmax 0.0 (- 1.0 (/ above *fc-city-soft*)))))
            )
          (let ((over (- (-> self control trans y) *fc-city-ceiling*)))
            (if (< 0.0 over) ;; above it (a big flap overshot, or a lower district crossed at height): ease down, never slam
                (set! (-> self control transv y) (fmin (-> self control transv y) (fmax (meters -12) (* -2.0 over))))
                )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior true-flight-flap-speed target ()
  "Vertical speed to leave a wing flap with: adds to any existing climb, capped."
  (let* ((up (-> self control dynam gravity-normal))
         (vspeed (vector-dot up (-> self control transv)))
         )
    ;; No altitude gate: target-height-above-ground measures to whatever is below you, so a
    ;; ceiling made flaps silently do nothing over streets/chasms ("randomly loses altitude").
    ;; flapping out of a glide (L1 held) is a big launch upward
    (if (cpad-hold? (-> self control cpad number) l1)
        (set! *tf-launch-until* (+ (current-time) *fc-launch-time*))
        )
    (let ((f (if (cpad-hold? (-> self control cpad number) l1)
                 (fmin *fc-big-flap-cap* (+ *fc-big-flap-impulse* (fmax 0.0 vspeed)))
                 (if *tf-dark-mode?* ;; Dark Jak: fewer, harder flaps
                     (fmin *fc-dark-climb-cap* (+ *fc-dark-flap-impulse* (fmax 0.0 vspeed)))
                     (fmin TF-CLIMB-CAP (+ TF-FLAP-IMPULSE (fmax 0.0 vspeed)))
                     )
                 )
             )
          )
      ;; city ceiling: no flap climbs faster than 2 m/s per metre of room left
      (if (and *fc-in-city?* (< 0.0 *fc-city-ceiling*))
          (fmin f (fmax 0.0 (* 2.0 (- *fc-city-ceiling* (-> self control trans y)))))
          f
          )
      )
    )
  )

;; Hold X through a flap for more height: after the flap's normal kick, holding X keeps pushing
;; up for a moment (up to *fc-flap-hold-bonus* extra climb). Releasing ends it for that flap.
(define *tf-flap-holding?* #f)
(define *tf-flap-hold-given* 0.0)

(defbehavior true-flight-flap-hold target ()
  "Per-frame in the flap states: extra lift while X stays held."
  (cond
    ((and *tf-flap-holding?*
          (cpad-hold? (-> self control cpad number) x)
          (< *tf-flap-hold-given* *fc-flap-hold-bonus*)
          )
     (let* ((up (-> self control dynam gravity-normal))
            (vs (vector-dot up (-> self control transv)))
            (dv (fmin (- *fc-flap-hold-bonus* *tf-flap-hold-given*) (* *fc-flap-hold-accel* (seconds-per-frame))))
            )
       ;; the flap's own cap still applies to tapped flaps; held flaps may exceed it by the bonus
       (set! dv (fmax 0.0 (fmin dv (- (+ TF-CLIMB-CAP *fc-flap-hold-bonus*) vs))))
       ;; gravity would eat the push, so cancel it too while holding
       (set! dv (+ dv (* (-> self control dynam gravity-length) (seconds-per-frame))))
       (vector+float*! (-> self control transv) (-> self control transv) up dv)
       (set! *tf-flap-hold-given* (+ *tf-flap-hold-given* dv))
       )
     )
    (else
      (set! *tf-flap-holding?* #f)
      )
    )
  (none)
  )

(defbehavior true-flight-lift target ()
  "Per-frame while flying: floaty gravity, higher camera. (Light form is kept up by the
   keep-alive state list in target-lightjak-process, not by the effect timer.)"
  (set! *true-flight-cam?* #t) ;; camera follows Jak's height (see cam-master.gc)
  (set-time! *tf-fly-time*)   ;; (a hit right now is a hit in flight)
  (set! *tf-hit-frames* 0)
  (set! *fc-safe-fall?* #t)   ;; no fall damage until Jak next stands on something
  (set! *tf-launching?* (< (current-time) *tf-launch-until*))
  (set! (-> self node-list data 3 param0) true-flight-main-joint)
  (if *tf-dark-mode?* ;; Dark Jak hunches (chest, node 6)
      (set! (-> self node-list data 6 param0) true-flight-dark-chest-joint)
      )
  (true-flight-city)
  (set! (-> self control dynam gravity-length) (if *tf-dark-mode?* *fc-dark-gravity* TF-GRAVITY))
  (set! (-> self control dynam gravity-max) FC-GRAVITY-MAX)
  ;; Flying is never a "fall": keep the fall origin under Jak so landing from any height is a
  ;; normal landing instead of target-hit-ground-hard (which can kill you from 30m+).
  (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
  ;; Hold R1 to fly fast -- only while flapping (the glide has its own turbo). In the plain fall
  ;; after you stop flapping, R1 used to fling Jak off into the distance.
  (true-flight-dark-ram) ;; Dark Jak's R1 dash
  (set! (-> self control mod-surface)
        (if (or *tf-dark-dashing?*
                (and (cpad-hold? (-> self control cpad number) r1)
                     (!= (-> self state name) 'target-lightjak-swoop-falling)
                     )
                )
            (cond
              (*tf-dark-dashing?* *tf-dark-dash-mods*)
              (*fc-in-city?* *lightjak-swoop-city-fast-mods*)
              (else *lightjak-swoop-fast-mods*)
              )
            (if *tf-dark-mode?* *tf-dark-swoop-mods* *lightjak-swoop-mods*)
            )
        )
  ;; NOTE: an earlier version damped your climb near the ceiling, but the ceiling is measured
  ;; from the ground *below* you, so flying out over a chasm made it yank altitude away at
  ;; random. The ceiling is now only enforced in the flap (no boost up there) -- nothing ever
  ;; takes away speed you already have.
  (none)
  )

;; === TRUE FLIGHT GLIDE ===
;; Hold L1 in flight to glide. Descent is held to a slow sink, and any faster fall is turned
;; into forward speed, so letting go of the climb at a peak swoops you forward. Speed eases
;; back toward a cruise speed slowly (momentum); R1 while gliding = turbo (fly nearly level,
;; accelerate to 90 m/s; the extra speed carries after release). The stick steers. X still flaps; keep holding L1 and you glide again after the flap.
;; Tuning values are globals so they can be changed live from the REPL.
;; Values both games share (glide, turbo, dash, landing, Dark Jak's flap) are in flight-core.gc.
(define *tf-glide-sink*       (meters 3))   ;; glide descent rate, m/s
(define *tf-glide-cruise*     (meters 18))  ;; speed a glide settles toward

(define *tf-gliding?* #f)

;; === TRUE FLIGHT SUPERHERO LANDING ===
;; Square while flying/gliding: plunge straight down in the dark-bomb dive pose, land in the
;; dark-bomb slam pose with a camera shake + rumble, never any fall damage.
(define *tf-slam-impact* 0.0)          ;; speed at touchdown, then 0..1 impact strength
;; jakb art-group slots. Only animations loaded in Light form work: the dark-bomb ones (466-468)
;; are #f outside Dark Jak and crashed the game. 66 flop-down-loop, 67 flop-down-land,
;; 500 lightjak-freeze-land, 483 lightjak-get-on-land, 497 lightjak-swoop-land.
(define *tf-slam-dive-anim* 65)   ;; flop-down: the ground-pound flip, played once and held
(define *tf-slam-brace-time* 0.15) ;; seconds before touchdown to swing upright into the landing pose
(define *tf-slam-braced?* #f)
(define *tf-slam-land-anim* 500) ;; lightjak-freeze-land, played on impact (slower = heavier for big drops)
(define-extern target-lightjak-slam (state target))
;; the superhero landing sets off a real dark bomb blast (effects + damage from target-darkjak-bomb0)
(define *tf-slam-blast?*      #t)
(define *tf-slam-blast-scale* 0.0)
(define *tf-slam-bomb-cur* (new 'static 'array float 1)) ;; growing collision radius (the bomb helper takes a pointer)
(define *tf-glide-speed* 0.0)
(define *tf-glide-cam-min* (meters 4)) ;; camera height above Jak while gliding
(define *tf-glide-cam-max* (meters 8))
(define *tf-glide-loop-rate* 0.6) ;; the glide animation's loop rate at cruise speed
(define *tf-glide-rate-min* 0.4)   ;; flap rate range; it scales with glide speed / cruise
(define *tf-glide-rate-max* 1.6)

(define *tf-glide-mods* (new 'static 'surface
                                :name 'glide
                                :turnv 65536.0
                                :turnvf 90.0
                                :turnvv 18204.445
                                :turnvvf 30.0
                                :tiltv 32768.0
                                :tiltvf 150.0
                                :tiltvv 262144.0
                                :tiltvvf 15.0
                                :transv-max 409600.0 ;; 100 m/s so turbo isn't clamped
                                :target-speed 184320.0
                                :seek0 0.05
                                :seek90 0.05
                                :seek180 0.05
                                :fric 0.05
                                :nonlin-fric-dist 1.0
                                :slip-factor 1.0
                                :slide-factor 1.0
                                :slope-up-factor 1.0
                                :slope-down-factor 1.0
                                :slope-slip-angle 1.0
                                :impact-fric 1.0
                                :bend-factor 1.0
                                :bend-speed 1.0
                                :alignv 1.0
                                :slope-up-traction 1.0
                                :align-speed 1.0
                                :mode 'air
                                :flags (surface-flag check-edge air gun-off no-board)
                                )
        )

(define *tf-dark-glide-mods* (let ((m (copy *tf-glide-mods* 'global)))
                               (set! (-> m name) 'dark-glide)
                               (set! (-> m turnv) 98304.0) ;; cuts sharper than Light's glide
                               m
                               )
  )

(defbehavior true-flight-glide target ()
  "Per-frame in swoop-falling. While L1 is held: glide physics. Returns #t while gliding."
  (cond
    ((not (cpad-hold? (-> self control cpad number) l1))
     (set! *tf-tilt-glide?* #f)
     (when *tf-gliding?*
       ;; back to the flight camera band
       (set-setting! 'string-min-height 'abs (meters 1) 0)
       (set-setting! 'string-max-height 'abs (meters 10) 0)
       )
     (set! *tf-gliding?* #f)
     #f
     )
    (else
      (let* ((up (-> self control dynam gravity-normal))
             (tv (-> self control transv))
             (vs (vector-dot up tv))
             (hv (vector-! (new-stack-vector0) tv (vector-float*! (new-stack-vector0) up vs)))
             (hs (vector-length hv))
             (fwd (vector-z-quaternion! (new-stack-vector0) (-> self control quat-for-control)))
             (dt (seconds-per-frame))
             (diving? (cpad-hold? (-> self control cpad number) r1)) ;; = turbo
             (sink (if diving? *fc-glide-turbo-sink* (if *tf-dark-mode?* *fc-dark-glide-sink* *tf-glide-sink*)))
             (cruise (if *tf-dark-mode?* *fc-dark-glide-cruise* *tf-glide-cruise*))
             (speed-before *tf-glide-speed*)
             )
        (set! *tf-tilt-glide?* #t)
        (when (not *tf-gliding?*)
          (set! *tf-gliding?* #t)
          (set! *tf-glide-speed* hs)
          ;; camera up above and behind Jak, looking down on the glide (the swoop :exit removes
          ;; these on landing)
          (set-setting! 'string-min-height 'abs *tf-glide-cam-min* 0)
          (set-setting! 'string-max-height 'abs *tf-glide-cam-max* 0)
          ;; faster catch-up than flight so the camera keeps up with a 90 m/s turbo
          (set-setting! 'string-spline-max-move-player 'abs (meters 8) 0)
          (set-setting! 'string-spline-accel-player 'abs (meters 0.2) 0)
          (set-setting! 'string-spline-max-move 'abs (meters 8) 0)
          (set-setting! 'string-spline-accel 'abs (meters 0.25) 0)
          )
        ;; hit a wall: lose the speed the wall took
        (if (logtest? (-> self control status) (collide-status touch-wall))
            (set! *tf-glide-speed* (fmin *tf-glide-speed* hs))
            )
        ;; falling faster than the sink rate: level out, turning that fall into speed
        (when (< vs (- sink))
          (let ((shed (fmin (- (- sink) vs) (* *fc-glide-catch* dt))))
            (set! vs (+ vs shed))
            ;; only real dive speed becomes forward speed. Gravity re-adds ~one frame's worth of
            ;; fall every frame; converting that too made a steady glide speed up on its own.
            (set! *tf-glide-speed*
                  (+ *tf-glide-speed*
                     (* *fc-glide-convert* (fmax 0.0 (- shed (* 1.5 (-> self control dynam gravity-length) dt))))
                     )
                  )
            )
          )
        (cond
          (diving?
            (set! *tf-glide-speed* (+ *tf-glide-speed* (* (if *fc-in-city?* *fc-glide-turbo-accel-city* *fc-glide-turbo-accel-open*) dt)))
            )
          ((< *tf-glide-speed* cruise)
           (set! *tf-glide-speed* (fmin cruise (+ *tf-glide-speed* (* *fc-glide-accel* dt))))
           )
          (else
            (set! *tf-glide-speed*
                  (- *tf-glide-speed* (* (- *tf-glide-speed* cruise) *fc-glide-drag* dt))
                  )
            )
          )
        ;; turbo tops out at turbo-max; otherwise nothing pushes past glide-max, but speed already
        ;; above it (after a turbo) is kept and bleeds off through the drag above -- momentum
        (set! *tf-glide-speed*
              (if diving?
                  (fmin (if *fc-in-city?* *fc-glide-turbo-max-city* *fc-glide-turbo-max-open*) *tf-glide-speed*)
                  (fmin *tf-glide-speed* (fmax *fc-glide-max* speed-before))
                  )
              )
        ;; carry on along the way Jak faces (the stick turns him)
        (vector-! fwd fwd (vector-float*! (new-stack-vector0) up (vector-dot up fwd)))
        (vector-normalize! fwd *tf-glide-speed*)
        (vector+! tv fwd (vector-float*! (new-stack-vector0) up vs))
        (set! (-> self control dynam gravity-length) *fc-glide-gravity*)
        (set! (-> self control mod-surface) (if *tf-dark-mode?* *tf-dark-glide-mods* *tf-glide-mods*))
        #t
        )
      )
    )
  )

(defbehavior true-flight-glide-pose target ()
  "Hold the glide pose: Light Jak's swoop2 flap cycle, looped faster the faster you glide (so an
   R1 dive flaps harder). The animation is only set when it changes (every frame was choppy)."
  (if (!= (ja-group) jakb-lightjak-swoop2-ja)
      (ja :group! jakb-lightjak-swoop2-ja :num! (identity 0.0))
      )
  (ja :num! (loop! (fmax *tf-glide-rate-min*
                         (fmin *tf-glide-rate-max* (* *tf-glide-loop-rate* (/ *tf-glide-speed* *tf-glide-cruise*)))
                         )
                   )
      )
  (none)
  )

(defstate target-lightjak-swoop (target)
  :event target-jump-event-handler
  :enter (behavior ((arg0 float))
    (set-time! (-> self state-time))
    (set! *tf-flap-holding?* #t) ;; TRUE FLIGHT MOD: holding X through this flap adds height
    (set! *tf-flap-hold-given* 0.0)
    (set-setting! 'gun #f 0.0 0)
    (set-setting! 'board #f 0.0 0)
    (apply-settings *setting-control*)
    (set! (-> self lightjak get-off-lock) #t)
    (set! (-> self fact lightjak-effect-time)
          (+ (- (seconds 20) (-> self fact lightjak-start-time)) (current-time))
          )
    (if (not (-> self lightjak wings))
        (set! (-> self lightjak wings) (process-spawn wings :init wings-init 'open :name "wings" :to self))
        )
    (when (and (-> self next-state) (= (-> self next-state name) 'target-lightjak-swoop))
      (if (not (or (logtest? (-> self lightjak stage) (lightjak-stage ls1)) *tf-dark-mode?*)) ;; TRUE FLIGHT: Dark Jak flies free
          (send-event self 'get-pickup (pickup-type eco-pill-light) (- (-> *FACT-bank* lightjak-swoop-inc)))
          )
      (send-event (ppointer->process (-> self lightjak wings)) 'open)
      )
    (set! (-> self control unknown-word04) (the-as uint #t))
    (set-time! (-> self control sliding-start-time))
    (set! (-> self control unknown-symbol03)
          (vector-dot (-> self control dynam gravity-normal) (-> self control transv))
          )
    (+! (-> self lightjak swoop-count) 1)
    (let ((f30-0 163840.0))
      (let ((f0-6 (if (and (-> self next-state) (= (-> self next-state name) 'target-lightjak-swoop))
                      1.4
                      (lerp-scale 0.0 1.0 (* arg0 arg0) 0.25 0.95)
                      )
                  )
            )
        (set! (-> self control unknown-float35) (* 0.0016666667 (* 285.0 f0-6) f30-0))
        )
      (set! (-> self control dynam gravity-max) 245760.0)
      (set! (-> self control dynam gravity-length) f30-0)
      )
    (logclear! (-> self control status) (collide-status on-surface on-ground touch-surface))
    (set! (-> self control mod-surface) *lightjak-swoop-mods*)
    (set-setting! 'string-min-height 'low (meters 1) 0)
    (set-setting! 'string-max-height 'low (meters 10) 0)
    ;; TRUE FLIGHT MOD: keep the vanilla camera height band (string-max-height is how high the
    ;; CAMERA floats above Jak, not how high Jak can fly) and let it keep up while climbing fast.
    ;; (catch-up raised with the 90 m/s R1 boost so the camera doesn't trail)
    (set-setting! 'string-spline-max-move-player 'abs (meters 8) 0)
    (set-setting! 'string-spline-accel-player 'abs (meters 0.2) 0)
    (set-setting! 'string-spline-max-move 'abs (meters 8) 0)
    (set-setting! 'string-spline-accel 'abs (meters 0.25) 0)
    (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
    )
  :exit (behavior ()
    (remove-setting! 'board)
    (remove-setting! 'gun)
    (when (not (and (-> self next-state) (let ((v1-7 (-> self next-state name)))
                                           (or (= v1-7 'target-lightjak-swoop) (= v1-7 'target-lightjak-swoop-again))
                                           )
                    )
               )
      (set! (-> self control dynam gravity-max) (-> self control standard-dynamics gravity-max))
      (set! (-> self control dynam gravity-length) (-> self control standard-dynamics gravity-length))
      (remove-setting! 'string-min-height)
      (remove-setting! 'string-max-height)
      (remove-setting! 'string-spline-max-move-player) ;; TRUE FLIGHT MOD
      (remove-setting! 'string-spline-accel-player)
      (remove-setting! 'string-spline-max-move)
      (remove-setting! 'string-spline-accel)
      )
    (set! *true-flight-cam?* #f) ;; TRUE FLIGHT MOD (flight states set it again every frame)
    (set! *tf-launching?* #f)
    (set! *tf-tilt-glide?* #f)
    (target-exit)
    )
  :trans (behavior ()
    (if (logtest? (-> self control status) (collide-status on-surface))
        (go target-hit-ground #f)
        )
    (if #t
        (set-time! (-> self control sliding-start-time))
        (set! (-> self control unknown-word04) (the-as uint #f))
        )
    (true-flight-lift) ;; TRUE FLIGHT MOD (vanilla restored normal gravity here after 0.2s)
    (true-flight-flap-hold) ;; TRUE FLIGHT MOD: hold X for a bigger flap
    (if (cpad-pressed? (-> self control cpad number) square) ;; TRUE FLIGHT: superhero landing
        (go target-lightjak-slam)
        )
    ;; TRUE FLIGHT GLIDE: tap L1 mid-flap to break into a glide
    (if (and (cpad-pressed? (-> self control cpad number) l1) (time-elapsed? (-> self state-time) (seconds 0.1)))
        (go target-lightjak-swoop-falling #f)
        )
    (if (or (and (< (vector-dot (-> self control dynam gravity-normal) (-> self control transv)) 0.0)
                 (and (< (target-height-above-ground) 4096.0)
                      (or (= (-> self control gspot-pat-surfce mode) (pat-mode ground))
                          (= (-> self control gspot-pat-surfce mode) (pat-mode halfpipe))
                          )
                      )
                 )
            (!= (-> self fact shield-level) 0.0)
            )
        (go target-lightjak-swoop-falling #f)
        )
    0
    )
  :code (behavior ((arg0 float))
    (true-flight-flap-sound) ;; TRUE FLIGHT (Dark Jak has his own)
    (ja-channel-push! 1 (seconds 0.05))
    ;; TRUE FLIGHT: a Dark Jak takeoff skips the unfurl (swoop1) and bursts straight into the
    ;; full-spread flap (swoop2); the wings copy whichever Jak plays
    (if *tf-dark-takeoff?*
        (ja-no-eval :group! jakb-lightjak-swoop2-ja :num! (seek!) :frame-num *tf-dark-takeoff-frame*)
        (ja-no-eval :group! jakb-lightjak-swoop1-ja :num! (seek!) :frame-num 0.0)
        )
    (set! *tf-dark-takeoff?* #f)
    (let ((v1-16 (new-stack-vector0)))
      (let ((f0-5 (vector-dot (-> self control dynam gravity-normal) (-> self control transv))))
        0.0
        (vector-! v1-16 (-> self control transv) (vector-float*! v1-16 (-> self control dynam gravity-normal) f0-5))
        )
      (let* ((f0-6 (vector-length v1-16))
             (f1-1 f0-6)
             (f2-0 (true-flight-flap-speed)) ;; TRUE FLIGHT MOD
             )
        (vector+!
          (-> self control transv)
          (vector-float*! (-> self control transv) (-> self control dynam gravity-normal) f2-0)
          (vector-float*! v1-16 v1-16 (/ f0-6 f1-1))
          )
        )
      )
    (true-flight-dark-flap) ;; TRUE FLIGHT: Dark Jak surges forward
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      ;; TRUE FLIGHT MOD: cooldown 0.5 -> 0.35 so flaps can stack
      (if (and (cpad-pressed? (-> self control cpad number) x) (time-elapsed? (-> self state-time) (if *tf-dark-mode?* *fc-dark-flap-cooldown* (seconds 0.35))))
          (go
            target-lightjak-swoop-again
            (* 0.0033333334 (the float (- (-> self control sliding-start-time) (-> self state-time))))
            )
          )
      )
    (go target-lightjak-swoop-falling #f)
    )
  :post target-post
  )

(defstate target-lightjak-swoop-again (target)
  :event target-jump-event-handler
  :enter (-> target-lightjak-swoop enter)
  :exit (-> target-lightjak-swoop exit)
  :trans (-> target-lightjak-swoop trans)
  :code (behavior ((arg0 float))
    (true-flight-flap-sound) ;; TRUE FLIGHT (Dark Jak has his own)
    (let ((f30-0 44.0))
      (let ((a1-1 6))
        (let ((v1-4 (ja-group)))
          (cond
            ((and v1-4 (= v1-4 jakb-lightjak-swoop1-ja))
             (set! f30-0 (lerp-scale 48.0 44.0 (ja-aframe-num 0) 30.0 44.0))
             (set! a1-1 30)
             )
            ((let ((v1-11 (ja-group)))
               (and v1-11 (= v1-11 jakb-lightjak-swoop2-ja))
               )
             (set! f30-0 (lerp-scale 48.0 44.0 (ja-aframe-num 0) 54.0 74.0))
             (set! a1-1 30)
             )
            ((let ((v1-18 (ja-group)))
               (and v1-18 (or (= v1-18 jakb-lightjak-swoop-fall-ja) (= v1-18 jakb-lightjak-swoop-fall-loop-ja)))
               )
             (ja-channel-push! 1 (seconds 0.2))
             (ja-no-eval :group! jakb-lightjak-swoop2-ja :num! (seek! max 2.0) :frame-num (ja-aframe 69.0 0))
             (until (ja-done? 0)
               (let ((v1-37 (new-stack-vector0))
                     (f0-5 (vector-dot (-> self control dynam gravity-normal) (-> self control transv)))
                     )
                 0.0
                 (vector-! v1-37 (-> self control transv) (vector-float*! v1-37 (-> self control dynam gravity-normal) f0-5))
                 (let* ((f1-2 (vector-length v1-37))
                        (f2-0 f1-2)
                        (f0-6 (* 0.95 f0-5))
                        )
                   (vector+!
                     (-> self control transv)
                     (vector-float*! (-> self control transv) (-> self control dynam gravity-normal) f0-6)
                     (vector-float*! v1-37 v1-37 (/ f1-2 f2-0))
                     )
                   )
                 )
               (suspend)
               (ja :num! (seek! max 2.0))
               )
             (set! a1-1 0)
             )
            )
          )
        (ja-channel-push! 1 (the-as time-frame a1-1))
        )
      (ja-no-eval :group! jakb-lightjak-swoop2-ja :num! (seek!) :frame-num (ja-aframe f30-0 0))
      )
    (while (< (ja-aframe-num 0) 48.0)
      (suspend)
      (ja :num! (seek!))
      )
    (let ((v1-73 (new-stack-vector0)))
      (let ((f0-20 (vector-dot (-> self control dynam gravity-normal) (-> self control transv))))
        0.0
        (vector-! v1-73 (-> self control transv) (vector-float*! v1-73 (-> self control dynam gravity-normal) f0-20))
        )
      (let* ((f0-21 (vector-length v1-73))
             (f1-5 f0-21)
             (f2-1 (true-flight-flap-speed)) ;; TRUE FLIGHT MOD
             )
        (vector+!
          (-> self control transv)
          (vector-float*! (-> self control transv) (-> self control dynam gravity-normal) f2-1)
          (vector-float*! v1-73 v1-73 (/ f0-21 f1-5))
          )
        )
      )
    (true-flight-dark-flap) ;; TRUE FLIGHT: Dark Jak surges forward
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      (if (and (cpad-pressed? (-> self control cpad number) x)
               (time-elapsed? (-> self state-time) (if *tf-dark-mode?* *fc-dark-flap-cooldown* (seconds 0.35))) ;; TRUE FLIGHT MOD
               (and (>= (ja-aframe-num 0) 54.0) 0)
               )
          (go
            target-lightjak-swoop-again
            (* 0.0033333334 (the float (- (-> self control sliding-start-time) (-> self state-time))))
            )
          )
      )
    (go target-lightjak-swoop-falling #f)
    )
  :post target-post
  )

(defstate target-lightjak-swoop-falling (target)
  :event target-jump-event-handler
  :enter (behavior ((arg0 symbol))
    (set-setting! 'gun #f 0.0 0)
    (set-setting! 'board #f 0.0 0)
    (apply-settings *setting-control*)
    (set! (-> self control mod-surface) *jump-mods*)
    (set! (-> self control unknown-word04) (the-as uint arg0))
    (set-time! (-> self state-time))
    (set! *tf-gliding?* #f) ;; TRUE FLIGHT GLIDE
    (set! *tf-flap-holding?* #f)
    )
  :exit (-> target-lightjak-swoop exit)
  :trans (behavior ()
    (true-flight-lift) ;; TRUE FLIGHT MOD
    ;; TRUE FLIGHT MOD: vanilla refused the flap when target-height-above-ground < 2m, but high up
    ;; the ground probe misses and reads 0, so a long fall locked you out of flying. Only refuse
    ;; when actually standing on something.
    (if (and (cpad-pressed? (-> self control cpad number) x)
             (not (logtest? (-> self control status) (collide-status on-surface)))
             (= (-> self fact shield-level) 0.0)
             )
        (go target-lightjak-swoop-again 1.0)
        )
    (true-flight-glide) ;; TRUE FLIGHT GLIDE
    (if (cpad-pressed? (-> self control cpad number) square) ;; TRUE FLIGHT: superhero landing
        (go target-lightjak-slam)
        )
    (target-falling-trans
      (the-as symbol (-> self control unknown-spool-anim00))
      ;; TRUE FLIGHT: no "stuck" check while flying free. Hovering at the top of a climb barely moves
      ;; Jak, which the check took for being wedged: it forced a landing in mid-air and he dropped.
      ;; (Still checked when he's actually touching a wall or a surface.)
      (the-as time-frame (cond
                           ((not (logtest? (-> self control status) (collide-status touch-surface touch-wall)))
                            -1
                            )
                           ((= (-> self control unknown-spool-anim00) #f)
                            0
                            )
                           (else
                             (the-as int (/ (the-as int (-> *TARGET-bank* stuck-time)) 2))
                             )
                           )
              )
      #f
      )
    )
  :code (behavior ((arg0 symbol))
    (ja-channel-push! 1 (seconds 0.1))
    (ja-no-eval :group! jakb-lightjak-swoop-fall-ja :num! (seek!) :frame-num 0.0)
    (until (or (ja-done? 0) *tf-gliding?*)
      (suspend)
      (ja :num! (seek!))
      )
    (until #f
      (cond
        (*tf-gliding?* ;; TRUE FLIGHT GLIDE: hold a wings-spread pose while gliding
          (ja-channel-push! 1 (seconds 0.25))
          (true-flight-glide-pose)
          (while *tf-gliding?*
            (suspend)
            (true-flight-glide-pose)
            )
          (ja-channel-push! 1 (seconds 0.15))
          )
        (else
          (ja-no-eval :group! jakb-lightjak-swoop-fall-loop-ja :num! (seek!) :frame-num 0.0)
          (until (or (ja-done? 0) *tf-gliding?*)
            (suspend)
            (ja :num! (seek!))
            )
          )
        )
      )
    #f
    )
  :post target-post
  )


(defbehavior tf-dark-bomb-flash process-drawable ()
  "The dark bomb blast's flash (white, to purple, to nothing), as target-darkjak-bomb0 does it."
  (set-vector! (-> self draw color-mult) 0.0 0.0 0.0 1.0)
  (let ((f (ja-aframe-num 0)))
    (cond
      ((>= 10.0 f)
       (set-vector! (-> self draw color-emissive) 1.0 1.0 1.0 1.0)
       )
      ((>= 20.0 f)
       (vector-lerp! (-> self draw color-emissive)
                     (new 'static 'vector :x 1.0 :y 1.0 :z 1.0 :w 1.0)
                     (new 'static 'vector :x 0.5 :z 1.0 :w 1.0)
                     (lerp-scale 0.0 1.0 f 10.0 20.0)
                     )
       )
      (else
        (vector-lerp! (-> self draw color-emissive)
                      (new 'static 'vector :x 0.5 :z 1.0 :w 1.0)
                      (new 'static 'vector :w 1.0)
                      (lerp-scale 0.0 1.0 f 20.0 30.0)
                      )
        )
      )
    )
  (none)
  )

(defbehavior tf-slam-land-anim target ((blend time-frame))
  "Start the landing pose: Dark Jak's bomb-land (468) for a dark slam once the dark set is back,
   else Light Jak's freeze-land, else the plain ground-pound landing (always loaded)."
  (cond
    ((and *tf-dark-slam?* (fc-slam-anim 468 blend))
     #t
     )
    ((fc-slam-anim *tf-slam-land-anim* blend)
     #t
     )
    (else
      (fc-slam-anim 67 blend)
      )
    )
  )

(defstate target-lightjak-slam (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('swim 'attack 'attack-or-shove)
       ;; unlike the bomb's handler (which ignores these), a slam into water swims and a slam into
       ;; lava or dark eco hurts, like any other landing
       (target-dangerous-event-handler proc argc message block)
       )
      (else
        ;; the dark bomb's own handler, so the blast registers hits
        ((-> target-darkjak-bomb0 event) proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! *tf-gliding?* #f)
    (set! *tf-flap-holding?* #f)
    (set! (-> self control mod-surface) *lightjak-swoop-mods*)
    ;; Dark Jak: the real dark bomb -- fold the wings (the dark set comes back in :trans) and queue
    ;; the bomb's sound
    (set! *tf-dark-slam?* (and *tf-dark-mode?* (true-flight-dark?)))
    (set! *tf-dark-slam-diving?* #f)
    (when *tf-dark-slam?*
      (send-event (ppointer->process (-> self lightjak wings)) 'end-mode)
      (set! (-> self control unknown-sound-id00)
            (add-process *gui-control* self (gui-channel jak-effect-1) (gui-action queue) "darkbom0" -99.0 0)
            )
      )
    ;; straight down, fast, keeping a little of the forward speed
    (fc-slam-plunge-start)
    )
  :exit (behavior ()
    (set! (-> self control dynam gravity-max) (-> self control standard-dynamics gravity-max))
    (set! (-> self control dynam gravity-length) (-> self control standard-dynamics gravity-length))
    (set! *true-flight-cam?* #f)
    (set! (-> self control bomb-scale) 0.0)
    (when *tf-dark-slam?*
      (set! *tf-dark-slam?* #f)
      (set-action! *gui-control* (gui-action fade) (-> self control unknown-sound-id00) (gui-channel none) (gui-action none)
                   (the-as string #f) (the-as (function gui-connection symbol) #f) (the-as process #f)
                   )
      ;; the flight is over: the dark set stays
      (true-flight-dark-drop-wings)
      (set! *tf-dark-mode?* #f)
      (set! *tf-dark-folding?* #f)
      (if (true-flight-dark?)
          (set! (-> self pending-ext-anim) (target-anim dark))
          )
      )
    ;; the dark bomb's hit handler can switch on its slow-motion clock; this slam doesn't run it
    (when (nonzero? (-> self darkjak))
      (set! (-> self darkjak clock-on) #f)
      (set! (-> self darkjak clock-pos) 1.0)
      (set! (-> self darkjak clock-vel) 0.0)
      )
    (target-exit)
    )
  :trans (behavior ()
    ;; the engine clamps every fall to gravity-max (40 m/s) -- lift it or the plunge stays floaty
    ;; (:exit restores the standard value)
    (set! (-> self control dynam gravity-max) (+ (meters 10) *fc-slam-boost-max*))
    ;; no fall damage from any height
    (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
    (if (not (focus-test? self light dark)) ;; light (or dark) form ended anyway (e.g. out of eco): just fall
        (go target-falling #f)
        )
    (if (and *tf-dark-slam?* (time-elapsed? (-> self state-time) *tf-dark-slam-swap*))
        (set! (-> self pending-ext-anim) (target-anim dark))
        )
    (set! *true-flight-cam?* #t)
    ;; the plunge is still flight: streaming, the game's current level and the abyss net keep running
    (fs-tick)
    )
  :code (behavior ()
    (sound-play "ltjak-flap")
    (fc-slam-anim *tf-slam-dive-anim* (seconds 0.1))
    (set! *tf-slam-impact* *fc-slam-speed*)
    (set! *tf-slam-braced?* #f)
    (until (logtest? (-> self control status) (collide-status on-surface))
      ;; accelerate the plunge: the longer the drop, the harder the hit
      (set! *tf-slam-impact* (fc-slam-plunge-step)) ;; hold Square = faster
      ;; dark slam: once the dark set is back, dive in the dark bomb's plunge pose
      (when (and *tf-dark-slam?* (not *tf-dark-slam-diving?*) (not *tf-slam-braced?*)
                 (= (-> self ext-anim) (target-anim dark))
                 (fc-slam-anim 467 (seconds 0.1))
                 )
        (set! *tf-dark-slam-diving?* #t)
        )
      (suspend)
      ;; just before touchdown, swing upright into the landing pose (so he lands on his feet, not
      ;; his head). Height is only trusted near the ground: a probe miss high up reads 0.
      (let ((h (target-height-above-ground)))
        (when (and (not *tf-slam-braced?*)
                   (< 1024.0 h)
                   (< h (* *tf-slam-impact* *tf-slam-brace-time*))
                   (tf-slam-land-anim (seconds 0.12))
                   )
          (set! *tf-slam-braced?* #t)
          )
        )
      (cond
        (*tf-slam-braced?*
          (ja :num! (identity 0.0))
          )
        (else
          (ja :num! (seek!))
          )
        )
      )
    ;; impact: heavier the faster we hit
    (set-forward-vel 0.0)
    (let ((k (lerp-scale 0.0 1.0 *tf-slam-impact* *fc-slam-speed* *fc-slam-max*)))
      (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 255 (the-as time-frame (the int (lerp 45.0 270.0 k))))
      (activate! *camera-smush-control* (lerp 300.0 2400.0 k) 15 (the int (lerp 40.0 120.0 k)) 1.0 0.9 (-> *display* camera-clock))
      (set! *tf-slam-impact* k)
      )
    (if (and (not *tf-slam-braced?*) (not (tf-slam-land-anim (seconds 0.05))))
        (go target-stance)
        )
    ;; dark bomb-land: the fist hits the ground at aframe 35 -- the blast goes off there
    (when (let ((g (ja-group))) (and *tf-dark-slam?* g (= g (-> self draw art-group data 468))))
      (until (or (ja-done? 0) (>= (ja-aframe-num 0) 35.0))
        (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
        (suspend)
        (ja :num! (seek! (ja-aframe 35.0 0) 1.5))
        )
      (set-action! *gui-control* (gui-action play) (-> self control unknown-sound-id00) (gui-channel none) (gui-action none)
                   (the-as string #f) (the-as (function gui-connection symbol) #f) (the-as process #f)
                   )
      )
    ;; ---- the dark bomb blast (from target-darkjak-bomb0), radius scaled by the drop ----
    (set! *tf-slam-blast-scale* 0.0)
    (when *tf-slam-blast?*
      (target-start-attack)
      (target-danger-set! 'bomb #f)
      (let ((radius (lerp *fc-slam-blast-min* *fc-slam-blast-max* *tf-slam-impact*))
            (pos (new 'stack-no-clear 'vector))
            )
        (set! (-> *tf-slam-bomb-cur* 0) 0.0)
        (vector-copy! pos (-> self control trans))
        (set! (-> pos y) (-> self control root-prim prim-core world-sphere y))
        (vector-copy! (-> *launch-matrix* trans) pos)
        ;; Light Jak's own burst instead of the dark bomb's purple sparks (the rings stay the dark
        ;; bomb's: their purple is baked into the texture)
        (cond
          (*tf-dark-slam?* ;; Dark Jak: the dark bomb's own purple burst
            (if (logtest? (-> group-darkjak-bomb flags) (sp-group-flag sp13))
                (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group-darkjak-bomb)
                (part-tracker-spawn part-tracker :to *entity-pool* :group group-darkjak-bomb)
                )
            )
          ((logtest? (-> group-lightjak-freeze-burst flags) (sp-group-flag sp13))
           (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group-lightjak-freeze-burst)
           )
          (else
            (part-tracker-spawn part-tracker :to *entity-pool* :group group-lightjak-freeze-burst)
            )
          )
        (when (not *tf-dark-slam?*) ;; Light Jak lands in a shower of light (the rings are the dark bomb's)
          (dotimes (i 60)
            (let ((sp (new 'stack-no-clear 'vector)))
              (vector-copy! sp pos)
              (+! (-> sp x) (* radius (meters 4) (rand-vu-float-range -1.0 1.0)))
              (+! (-> sp y) (* (meters 3) (rand-vu)))
              (+! (-> sp z) (* radius (meters 4) (rand-vu-float-range -1.0 1.0)))
              (launch-particles (-> *part-id-table* 646) sp)
              )
            )
          (vector-copy! (-> *launch-matrix* trans) pos)
          (part-tracker-spawn part-tracker :to *entity-pool* :group group-lightjak-freeze-burst)
          )
        (let ((ag (the-as art-group (if *tf-dark-slam?* (art-group-get-by-name *level* "skel-bomb-blast" (the-as (pointer level) #f)) #f))))
          (when ag
            (let ((b (process-spawn manipy :init manipy-init pos (-> self entity) ag #f 0 :name "manipy" :to self :stack-size #x20000)))
              (when b
                (send-event (ppointer->process b) 'anim-mode 'play1)
                (send-event (ppointer->process b) 'anim "idle")
                (set-vector! (-> (the-as process-drawable (-> b 0)) root scale) radius 1.0 radius 1.0)
                (if *tf-dark-slam?* ;; the dark bomb's white-to-purple flash
                    (send-event (ppointer->process b) 'trans-hook tf-dark-bomb-flash)
                    )
                )
              )
            )
          )
        (let ((ag (the-as art-group (if *tf-dark-slam?* (art-group-get-by-name *level* "skel-generic-blast" (the-as (pointer level) #f)) #f))))
          (when ag
            (let ((b (process-spawn manipy :init manipy-init pos (-> self entity) ag #f 0 :name "manipy" :to self :stack-size #x20000)))
              (when b
                (send-event (ppointer->process b) 'anim-mode 'play1)
                (send-event (ppointer->process b) 'anim "idle")
                (set-vector! (-> (the-as process-drawable (-> b 0)) root scale) radius 1.0 radius 1.0)
                )
              )
            )
          )
        (set! *tf-slam-blast-scale* radius)
        )
      )
    (set-time! (-> self state-time)) ;; = impact time, for the early-out below
    (until (ja-done? 0)
      (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
      (if (< 0.0 *tf-slam-blast-scale*) ;; the damage: grow the bomb collision out, like the real dark bomb
          (target-darkjak-bomb-collide (&-> *tf-slam-bomb-cur* 0) *tf-slam-blast-scale*)
          )
      (suspend)
      (ja :num! (seek! max (lerp 1.2 0.8 *tf-slam-impact*)))
      ;; after the impact beat, any input takes control back instead of waiting out the crouch
      (if (and (time-elapsed? (-> self state-time) (seconds 0.25))
               (or (< 0.3 (-> *cpad-list* cpads (-> self control cpad number) stick0-speed))
                   (cpad-pressed? (-> self control cpad number) x square circle)
                   )
               )
          (go target-stance)
          )
      )
    (go target-stance)
    )
  :post target-post
  )

(deftype freeze-screen (process-drawable)
  ((anim-frame  float)
   (transition  float)
   (gui-id-1    sound-id)
   (gui-id-2    sound-id)
   )
  (:state-methods
    idle
    active
    (deactive symbol)
    die
    )
  (:methods
    (freeze-screen-method-24 (_type_) none)
    )
  )


(defskelgroup skel-freeze-screen collectables collectables-warp-time-lod0-jg collectables-warp-time-idle-ja
              ((collectables-warp-time-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 8)
              )

(defstate idle (freeze-screen)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('trigger)
       (set-time! (-> self state-time))
       (go-virtual active)
       )
      (('die)
       (go-virtual die)
       )
      (('untrigger)
       (if (-> block param 0)
           (go-virtual die)
           )
       )
      )
    )
  :enter (behavior ()
    (logior! (-> self draw status) (draw-control-status no-draw))
    (set! (-> self transition) 0.0)
    )
  :code sleep-code
  )

(defstate active (freeze-screen)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('untrigger)
       (go-virtual deactive (the-as symbol (-> block param 0)))
       )
      (('die)
       (go-virtual die)
       )
      )
    )
  :enter (behavior ()
    (logclear! (-> self draw status) (draw-control-status no-draw))
    )
  :code (behavior ()
    (until #f
      (set! (-> self anim-frame) (* 15.0 (- 1.0 (-> *setting-control* user-current slow-time))))
      (set! (-> self transition) (-> *setting-control* user-current slow-time))
      (ja :num-func num-func-identity :frame-num (-> self anim-frame))
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (freeze-screen-method-24 self)
    (ja-post)
    )
  )

(defstate deactive (freeze-screen)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go-virtual die)
       )
      )
    )
  :code (behavior ((arg0 symbol))
    (until #f
      (set! (-> self anim-frame) (* 15.0 (- 1.0 (-> *setting-control* user-current slow-time))))
      (set! (-> self transition) (-> *setting-control* user-current slow-time))
      (when (= (-> self anim-frame) 15.0)
        (if arg0
            (go-virtual die)
            (go-virtual idle)
            )
        )
      (ja :num-func num-func-identity :frame-num (-> self anim-frame))
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (freeze-screen-method-24 self)
    (ja-post)
    )
  )

(defstate die (freeze-screen)
  :virtual #t
  :code (behavior ()
    (suspend-for (seconds 1)
      (seek! (-> self transition) 0.0 (seconds-per-frame))
      )
    )
  )

(defmethod freeze-screen-method-24 ((this freeze-screen))
  (let ((s3-0 (camera-matrix))
        (s5-0 (new 'stack-no-clear 'vector))
        (gp-0 (new 'stack-no-clear 'vector))
        (f30-0 4096.0)
        )
    ;; og:preserve-this resize effect based on aspect ratio
    (let ((f0-4 (* 0.00013563369 (tan (* 0.5 (-> *math-camera* fov))) f30-0)))
      (set-vector! (-> this root scale) (* f0-4 (if (-> *pc-settings* use-vis?) 1.0 (-> *pc-settings* aspect-ratio-scale))) f0-4 f0-4 1.0)
      )
    (vector-copy! gp-0 (camera-pos))
    (vector-normalize-copy! s5-0 (-> s3-0 fvec) 1.0)
    (matrix->quaternion (-> this root quat) s3-0)
    (vector+*! (-> this root trans) gp-0 s5-0 f30-0)
    )
  0
  (none)
  )

(defbehavior freeze-screen-init freeze-screen ((arg0 vector) (arg1 quaternion) (arg2 entity))
  (process-entity-set! self arg2)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) arg0)
  (quaternion-copy! (-> self root quat) arg1)
  (initialize-skeleton
    self
    (the-as skeleton-group (art-group-get-by-name *level* "skel-freeze-screen" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (set! (-> self anim-frame) 15.0)
  (set! (-> self transition) 0.0)
  (set-vector! (-> self draw color-emissive) 0.0 0.0 0.0 0.0)
  (set-vector! (-> self draw color-emissive) 0.0 0.0 0.0 0.0)
  (logior! (-> self skel status) (joint-control-status blend-shape))
  (ja :group! collectables-warp-time-end-ja)
  (set-setting! 'freeze-screen #t 0.0 0)
  (go-virtual idle)
  )

(defmethod deactivate ((this freeze-screen))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (disable *screen-filter*)
  (call-parent-method this)
  (none)
  )

(deftype freeze-control (process)
  ((clock-pos      float)
   (freeze-screen  handle)
   (sound-id       sound-id)
   (tick-time      time-frame)
   (abort?         symbol)
   (freeze-id      sound-id)
   )
  (:state-methods
    idle
    )
  )


(defstate idle (freeze-control)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (let ((v0-0 (-> block param 0)))
         (set! (-> self abort?) (the-as symbol v0-0))
         v0-0
         )
       )
      )
    )
  :enter (behavior ()
    (set-setting! 'music-volume 'rel 0.5 0)
    (set-setting! 'sfx-volume 'rel 0.9 0)
    (set-setting! 'ambient-volume 'rel 0.9 0)
    (let ((a1-3 (new 'stack-no-clear 'event-message-block)))
      (set! (-> a1-3 from) (process->ppointer self))
      (set! (-> a1-3 num-params) 1)
      (set! (-> a1-3 message) 'test-pickup)
      (set! (-> a1-3 param 0) (the-as uint 8))
      (let ((f0-0 (the-as float (send-event-function (ppointer->process (-> self parent)) a1-3))))
        (send-event
          (ppointer->process (-> self parent))
          'get-pickup
          (pickup-type eco-pill-light)
          (- (fmin (-> *FACT-bank* lightjak-freeze-inc) (+ -1.0 f0-0)))
          )
        )
      )
    (set-action!
      *gui-control*
      (gui-action play)
      (-> self sound-id)
      (gui-channel none)
      (gui-action none)
      (the-as string #f)
      (the-as (function gui-connection symbol) #f)
      (the-as process #f)
      )
    )
  :exit (behavior ()
    (update-rates! (-> *display* entity-clock) 1.0)
    (update-rates! (-> *display* bg-clock) 1.0)
    (update-rates! (-> *display* part-clock) 1.0)
    (update-rates! (-> *display* target-clock) 1.0)
    (send-event (handle->process (-> self freeze-screen)) 'untrigger #t)
    (let ((f30-0 1.0))
      (if (>= f30-0 (send-event (ppointer->process (-> self parent)) 'test-pickup (pickup-type eco-pill-light)))
          (send-event (ppointer->process (-> self parent)) 'get-pickup (pickup-type eco-pill-light) -100.0)
          )
      )
    (set-action!
      *gui-control*
      (gui-action fade)
      (-> self sound-id)
      (gui-channel none)
      (gui-action none)
      (the-as string #f)
      (the-as (function gui-connection symbol) #f)
      (the-as process #f)
      )
    (remove-setting! 'music-volume)
    (remove-setting! 'sfx-volume)
    (remove-setting! 'ambient-volume)
    )
  :code (behavior ()
    (set! (-> self clock-pos) 1.0)
    (suspend)
    (send-event (handle->process (-> self freeze-screen)) 'trigger)
    (while (< 0.05 (-> self clock-pos))
      (seek! (-> self clock-pos) 0.05 (seconds-per-frame))
      (suspend)
      )
    (let ((gp-0 (current-time)))
      (while (and (not (time-elapsed? gp-0 (the-as time-frame (-> *FACT-bank* lightjak-freeze-duration))))
                  (let ((v1-15 #x20000)
                        (a0-8 (-> self parent))
                        )
                    (logtest? (the-as focus-status v1-15)
                              (-> (the-as process-focusable (if a0-8
                                                                (the-as process-focusable (-> a0-8 0 self))
                                                                )
                                          )
                                  focus-status
                                  )
                              )
                    )
                  (not (-> self abort?))
                  )
        (suspend)
        )
      )
    (while (< (-> self clock-pos) 1.0)
      (case (-> self abort?)
        (('force)
         (return #f)
         )
        )
      (seek! (-> self clock-pos) 1.0 (* 2.0 (seconds-per-frame)))
      (suspend)
      )
    )
  :post (behavior ()
    (set-setting! 'slow-time 'abs (lerp-scale 1.0 0.0 (-> self clock-pos) 0.05 1.0) 0)
    (apply-settings *setting-control*)
    (format *stdebug* "freeze = ~,,2f   ~,,2~%" (-> self clock-pos) (-> *setting-control* user-current slow-time))
    (update-rates! (-> *display* entity-clock) (-> self clock-pos))
    (update-rates! (-> *display* bg-clock) (-> self clock-pos))
    (update-rates! (-> *display* target-clock) (- 1.0 (* 0.1 (- 1.0 (-> self clock-pos)))))
    )
  )

(defbehavior freeze-control-init freeze-control ((arg0 sound-id))
  (set! (-> self clock-pos) 1.0)
  (set! (-> self sound-id) arg0)
  (set! (-> self abort?) #f)
  (set! (-> self freeze-screen)
        (ppointer->handle
          (process-spawn
            freeze-screen
            :init freeze-screen-init
            (math-camera-pos)
            *null-vector*
            (-> self entity)
            :name "freeze-screen"
            :to *display-pool*
            )
          )
        )
  (set! (-> self freeze-id)
        (add-process *gui-control* self (gui-channel freeze) (gui-action play) "freeze" -99.0 0)
        )
  (go-virtual idle)
  )

(deftype freeze-watcher (process)
  ((parent     (pointer process-focusable) :override)
   (old-clock  clock)
   )
  (:state-methods
    (active clock)
    )
  )


(defstate active (freeze-watcher)
  :virtual #t
  :exit (behavior ()
    (+! (-> self parent 0 clock ref-count) -1)
    (+! (-> self old-clock ref-count) 1)
    (set! (-> self parent 0 clock) (-> self old-clock))
    )
  :code (behavior ((arg0 clock))
    (let ((s4-0 (-> self parent 0 clock))
          (gp-0 (current-time))
          )
      (copy! arg0 s4-0)
      (+! (-> s4-0 ref-count) -1)
      (+! (-> arg0 ref-count) 1)
      (set! (-> self parent 0 clock) arg0)
      (+! (-> self clock ref-count) -1)
      (+! (-> self parent 0 clock ref-count) 1)
      (set! (-> self clock) (-> self parent 0 clock))
      (while (let ((v1-31 (as-type (ppointer->process (-> self parent)) process-focusable)))
               (and v1-31
                    (or (focus-test? v1-31 dead hit) (and (-> v1-31 next-state) (let ((v1-34 (-> v1-31 next-state name)))
                                                                                  (or (= v1-34 'hit)
                                                                                      (= v1-34 'knocked)
                                                                                      (= v1-34 'knocked-recover)
                                                                                      (= v1-34 'die)
                                                                                      (= v1-34 'die-falling)
                                                                                      (= v1-34 'die-fast)
                                                                                      )
                                                                                  )
                                                          )
                        )
                    (not (time-elapsed? gp-0 (seconds 5)))
                    )
               )
        (update-rates! (-> self clock) (seek (-> self clock clock-ratio) 1.0 (* 4.0 (seconds-per-frame))))
        (format *stdebug* "watcher ~d ~f~%" (-> self clock index) (-> self clock clock-ratio))
        (suspend)
        )
      )
    (while (!= (-> self clock clock-ratio) (lerp-scale 1.0 0.05 (-> *setting-control* user-current slow-time) 0.0 1.0))
      (update-rates! (-> self clock) (seek
                                       (-> self clock clock-ratio)
                                       (lerp-scale 1.0 0.05 (-> *setting-control* user-current slow-time) 0.0 1.0)
                                       (* 4.0 (seconds-per-frame))
                                       )
                     )
      (format *stdebug* "watcher ~d ~f~%" (-> self clock index) (-> self clock clock-ratio))
      (suspend)
      )
    )
  )

(defbehavior freeze-watcher-init freeze-watcher ((arg0 clock))
  (set! (-> self old-clock) (-> self parent 0 clock))
  (go-virtual active arg0)
  )

;; WARN: Function freeze-hit-begin has a return type of none, but the expression builder found a return statement.
(defbehavior freeze-hit-begin process ()
  (local-vars (gp-0 clock))
  (cond
    ((or (< (-> *setting-control* user-current slow-time) 0.01) (>= (-> self clock index) 12))
     )
    (else
      (if (>= (-> self clock index) 12)
          (return #f)
          )
      (dotimes (v1-12 10)
        (when (zero? (-> *display* clock (+ v1-12 12) ref-count))
          (set! gp-0 (-> *display* clock (+ v1-12 12)))
          (goto cfg-18)
          )
        )
      (return #f)
      (label cfg-18)
      (process-spawn freeze-watcher :init freeze-watcher-init gp-0 :name "freeze-watcher" :to self)
      )
    )
  0
  (none)
  )

(defbehavior freeze-hit-end process ()
  (let ((gp-0 (-> self child)))
    (while gp-0
      (send-event (ppointer->process gp-0) 'notice 'freeze-hit-end)
      (set! gp-0 (-> gp-0 0 brother))
      )
    )
  0
  (none)
  )

(defstate target-lightjak-freeze (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('pole-grab 'darkjak 'lightjak 'slide 'wade 'launch 'edge-grab 'jump 'shove 'attack 'attack-or-shove)
       #f
       )
      (('attack 'attack-or-shove 'swim)
       #f
       )
      (else
        (target-dangerous-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self target-flags) (target-flags tf4))
    (set! (-> self lightjak freeze-sound)
          (add-process *gui-control* self (gui-channel jak-mode) (gui-action queue) "ljfreeze" -99.0 0)
          )
    (set! (-> self lightjak get-off-lock) #t)
    )
  :exit (behavior ()
    (if (not (handle->process (-> self lightjak freeze-control)))
        (set-action!
          *gui-control*
          (gui-action stop)
          (-> self lightjak freeze-sound)
          (gui-channel none)
          (gui-action none)
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (logclear! (-> self target-flags) (target-flags tf4 tf6))
    (target-exit)
    )
  :code (behavior ()
    (send-event (handle->process (-> self notify)) 'notify 'attack 27)
    (set! (-> self neck flex-blend) 0.0)
    (vector-copy! (-> self alt-cam-pos) (-> self control trans))
    (if (logtest? (-> group-lightjak-freeze-hands flags) (sp-group-flag sp13))
        (part-tracker-spawn
          part-tracker-subsampler
          :to self
          :group group-lightjak-freeze-hands
          :target self
          :mat-joint 19
          )
        (part-tracker-spawn part-tracker :to self :group group-lightjak-freeze-hands :target self :mat-joint 19)
        )
    (if (logtest? (-> group-lightjak-freeze-hands flags) (sp-group-flag sp13))
        (part-tracker-spawn
          part-tracker-subsampler
          :to self
          :group group-lightjak-freeze-hands
          :target self
          :mat-joint 28
          )
        (part-tracker-spawn part-tracker :to self :group group-lightjak-freeze-hands :target self :mat-joint 28)
        )
    (set! (-> self control mod-surface) *roll-flip-mods*)
    (let ((f30-0 0.0))
      (if (time-elapsed? (-> self fact lightjak-start-time) (seconds 2))
          (set! f30-0 9.0)
          )
      (ja-channel-push! 1 (seconds 0.1))
      (ja-no-eval :group! jakb-lightjak-freeze-ja :num! (seek! (ja-aframe 20.0 0)) :frame-num (ja-aframe f30-0 0))
      )
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! (ja-aframe 20.0 0)))
      )
    (cond
      ((logtest? (-> group-lightjak-freeze-burst flags) (sp-group-flag sp13))
       (vector-copy!
         (-> *launch-matrix* trans)
         (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node jakb-lod0-jg sk_lhand))
         )
       (part-tracker-spawn part-tracker-subsampler :to self :group group-lightjak-freeze-burst)
       )
      (else
        (vector-copy!
          (-> *launch-matrix* trans)
          (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node jakb-lod0-jg sk_lhand))
          )
        (part-tracker-spawn part-tracker :to self :group group-lightjak-freeze-burst)
        )
      )
    (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 255 (seconds 0.5))
    (activate! *camera-smush-control* 819.2 15 75 1.0 0.9 (-> *display* camera-clock))
    (set! (-> self lightjak freeze-control) (ppointer->handle (process-spawn
                                                                freeze-control
                                                                :init freeze-control-init
                                                                (-> self lightjak freeze-sound)
                                                                :name "freeze-control"
                                                                :to self
                                                                )
                                                              )
          )
    (ja-no-eval :num! (seek!))
    (while (not (ja-done? 0))
      (suspend)
      (ja-eval)
      )
    (go target-stance)
    )
  :post target-no-stick-post
  )

(defstate target-lightjak-shield (target)
